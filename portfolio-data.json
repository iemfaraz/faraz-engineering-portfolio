    {
      "entity": "Project",
      "slug": "commercial-court",
      "order": 0,
      "cat": "gov",
      "title_en": "Commercial Court Project",
      "title_ar": "\u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u0645\u062d\u0643\u0645\u0629 \u0627\u0644\u062a\u062c\u0627\u0631\u064a\u0629",
      "summary_en": "Electrical design production, single line diagram validation, load balancing and multi-discipline coordination, in line with SBC and IEC.",
      "summary_ar": "\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u062a\u0635\u0627\u0645\u064a\u0645 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629\u060c \u0648\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0645\u062e\u0637\u0637\u0627\u062a \u0623\u062d\u0627\u062f\u064a\u0629 \u0627\u0644\u062e\u0637\u060c \u0648\u0645\u0648\u0627\u0632\u0646\u0629 \u0627\u0644\u0623\u062d\u0645\u0627\u0644\u060c \u0648\u0627\u0644\u062a\u0646\u0633\u064a\u0642 \u0628\u064a\u0646 \u0627\u0644\u062a\u062e\u0635\u0635\u0627\u062a\u060c \u0648\u0641\u0642 \u0643\u0648\u062f \u0627\u0644\u0628\u0646\u0627\u0621 \u0627\u0644\u0633\u0639\u0648\u062f\u064a \u0648\u0645\u0639\u0627\u064a\u064a\u0631 IEC.",
      "tags": "Power, Lighting, ELV, SBC",
      "engagement": "Basmat Al-Riyada Engineering Consultancy, Riyadh",
      "office": "Design office",
      "period": "2025 \u2014 2026",
      "disciplines": "LV power distribution, Lighting design, ELV systems",
      "standards": "SBC, IEC",
      "scope_en": "Produced the electrical design package and validated the single line diagram against the calculated load.\nBalanced loads across panels and sized feeders and protective devices.\nCoordinated electrical routes and containment with architectural and mechanical drawings before issue.\nPrepared drawings and schedules for consultant review.",
      "scope_ar": "\u0625\u0639\u062f\u0627\u062f \u062d\u0632\u0645\u0629 \u0627\u0644\u062a\u0635\u0645\u064a\u0645 \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a \u0648\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0645\u062e\u0637\u0637 \u0623\u062d\u0627\u062f\u064a \u0627\u0644\u062e\u0637 \u0645\u0642\u0627\u0628\u0644 \u0627\u0644\u0623\u062d\u0645\u0627\u0644 \u0627\u0644\u0645\u062d\u0633\u0648\u0628\u0629.\n\u0645\u0648\u0627\u0632\u0646\u0629 \u0627\u0644\u0623\u062d\u0645\u0627\u0644 \u0628\u064a\u0646 \u0627\u0644\u0644\u0648\u062d\u0627\u062a \u0648\u062a\u062d\u062f\u064a\u062f \u0645\u0642\u0627\u0633\u0627\u062a \u0627\u0644\u0645\u063a\u0630\u064a\u0627\u062a \u0648\u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0648\u0642\u0627\u064a\u0629.\n\u062a\u0646\u0633\u064a\u0642 \u0627\u0644\u0645\u0633\u0627\u0631\u0627\u062a \u0648\u0627\u0644\u0645\u062c\u0627\u0631\u064a \u0627\u0644\u0643\u0647\u0631\u0628\u0627\u0626\u064a\u0629 \u0645\u0639 \u0627\u0644\u0645\u062e\u0637\u0637\u0627\u062a \u0627\u0644\u0645\u0639\u0645\u0627\u0631\u064a\u0629 \u0648\u0627\u0644\u0645\u064a\u0643\u0627\u0646\u064a\u0643\u064a\u0629 \u0642\u0628\u0644 \u0627\u0644\u0625\u0635\u062f\u0627\u0631.\n\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0645\u062e\u0637\u0637\u0627\u062a \u0648\u0627\u0644\u062c\u062f\u0627\u0648\u0644 \u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u0627\u0633\u062a\u0634\u0627\u0631\u064a.",
      "id": "reference-commercial-court",
      "created_date": "2026-10-31T17:54:47.212Z"
