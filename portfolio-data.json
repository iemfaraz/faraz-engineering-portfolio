    {
      "entity": "Project",
      "slug": "al-qaa-housing",
      "order": 8,
      "cat": "elv",
      "title_en": "Al-Qaa Housing Project, Qunfudhah",
      "title_ar": "\u0645\u0634\u0631\u0648\u0639 \u0625\u0633\u0643\u0627\u0646 \u0627\u0644\u0642\u0627\u0639\u060c \u0627\u0644\u0642\u0646\u0641\u0630\u0629",
      "summary_en": "Coordinated multi-node data networks, structured cabling backbones, CCTV and biometric access control through to commissioning with Saleh Zuhair Al-Shamrani Holding Co.",
      "summary_ar": "\u062a\u0646\u0633\u064a\u0642 \u0634\u0628\u0643\u0627\u062a \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0645\u062a\u0639\u062f\u062f\u0629 \u0627\u0644\u0639\u0642\u062f\u060c \u0648\u0627\u0644\u0639\u0645\u0648\u062f \u0627\u0644\u0641\u0642\u0631\u064a \u0644\u0644\u0643\u0627\u0628\u0644\u0627\u062a \u0627\u0644\u0645\u0647\u064a\u0643\u0644\u0629\u060c \u0648\u0643\u0627\u0645\u064a\u0631\u0627\u062a \u0627\u0644\u0645\u0631\u0627\u0642\u0628\u0629 \u0648\u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0628\u064a\u0648\u0645\u062a\u0631\u064a \u0628\u0627\u0644\u062f\u062e\u0648\u0644 \u062d\u062a\u0649 \u0627\u0644\u062a\u0634\u063a\u064a\u0644\u060c \u0645\u0639 \u0634\u0631\u0643\u0629 \u0635\u0627\u0644\u062d \u0632\u0647\u064a\u0631 \u0627\u0644\u0634\u0645\u0631\u0627\u0646\u064a \u0627\u0644\u0642\u0627\u0628\u0636\u0629.",
      "tags": "Structured cabling, CCTV, Access control",
      "engagement": "Saleh Zuhair Al-Shamrani Holding Co., Khobar",
      "office": "Site execution",
      "period": "Aug 2023 \u2014 Jul 2024",
      "disciplines": "Structured cabling, Data networks, CCTV, Biometric access control",
      "standards": "IEC",
      "scope_en": "Coordinated multi-node data networks and the structured cabling backbone.\nManaged routing, containment and rack layouts for ELV systems.\nSupported testing and commissioning of CCTV and biometric access control.\nPrepared site logs and as-built drawings for closeout.",
      "scope_ar": "\u062a\u0646\u0633\u064a\u0642 \u0634\u0628\u0643\u0627\u062a \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0645\u062a\u0639\u062f\u062f\u0629 \u0627\u0644\u0639\u0642\u062f \u0648\u0627\u0644\u0639\u0645\u0648\u062f \u0627\u0644\u0641\u0642\u0631\u064a \u0644\u0644\u0643\u0627\u0628\u0644\u0627\u062a \u0627\u0644\u0645\u0647\u064a\u0643\u0644\u0629.\n\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u0633\u0627\u0631\u0627\u062a \u0648\u0627\u0644\u0645\u062c\u0627\u0631\u064a \u0648\u062a\u0648\u0632\u064a\u0639 \u0627\u0644\u0631\u0641\u0648\u0641 \u0644\u0623\u0646\u0638\u0645\u0629 \u0627\u0644\u062a\u064a\u0627\u0631 \u0627\u0644\u062e\u0641\u064a\u0641.\n\u062f\u0639\u0645 \u0627\u062e\u062a\u0628\u0627\u0631 \u0648\u062a\u0634\u063a\u064a\u0644 \u0643\u0627\u0645\u064a\u0631\u0627\u062a \u0627\u0644\u0645\u0631\u0627\u0642\u0628\u0629 \u0648\u0627\u0644\u062a\u062d\u0643\u0645 \u0627\u0644\u0628\u064a\u0648\u0645\u062a\u0631\u064a \u0628\u0627\u0644\u062f\u062e\u0648\u0644.\n\u0625\u0639\u062f\u0627\u062f \u0633\u062c\u0644\u0627\u062a \u0627\u0644\u0645\u0648\u0642\u0639 \u0648\u0645\u062e\u0637\u0637\u0627\u062a \u0645\u0627 \u0628\u0639\u062f \u0627\u0644\u062a\u0646\u0641\u064a\u0630 \u0644\u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0645\u0634\u0631\u0648\u0639.",
      "id": "reference-al-qaa-housing",
      "created_date": "2026-10-31T17:54:47.212Z"
    },
