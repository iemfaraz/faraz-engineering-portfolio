      "scope_ar": "\u062a\u062e\u0637\u064a\u0637 \u0645\u0633\u0627\u0631\u0627\u062a \u0627\u0644\u0628\u0646\u064a\u0629 \u0627\u0644\u062a\u062d\u062a\u064a\u0629 \u0644\u0644\u0634\u0628\u0643\u0627\u062a \u0648\u0627\u0644\u062a\u064a\u0627\u0631 \u0627\u0644\u062e\u0641\u064a\u0641.\n\u062a\u0646\u0633\u064a\u0642 \u0627\u0644\u0643\u0627\u0628\u0644\u0627\u062a \u0648\u0627\u0644\u0645\u062c\u0627\u0631\u064a \u0648\u0645\u0648\u0627\u0636\u0639 \u0627\u0644\u0631\u0641\u0648\u0641.",
