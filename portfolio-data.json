    {
      "entity": "Project",
      "slug": "padel-hall-lighting",
      "order": 9,
      "cat": "light",
      "title_en": "Padel Hall Lighting Design",
      "title_ar": "\u062a\u0635\u0645\u064a\u0645 \u0625\u0646\u0627\u0631\u0629 \u0635\u0627\u0644\u0629 \u0628\u0627\u062f\u0644",
      "summary_en": "Luminaire selection, photometric simulation and a client-ready presentation package for an indoor padel court, built in DIALux evo.",
      "summary_ar": "\u0627\u062e\u062a\u064a\u0627\u0631 \u0627\u0644\u0648\u062d\u062f\u0627\u062a \u0627\u0644\u0625\u0646\u0627\u0631\u064a\u0629 \u0648\u0645\u062d\u0627\u0643\u0627\u0629 \u0641\u0648\u062a\u0648\u0645\u062a\u0631\u064a\u0629 \u0648\u062d\u0632\u0645\u0629 \u0639\u0631\u0636 \u062c\u0627\u0647\u0632\u0629 \u0644\u0644\u0639\u0645\u064a\u0644 \u0644\u0645\u0644\u0639\u0628 \u0628\u0627\u062f\u0644 \u062f\u0627\u062e\u0644\u064a\u060c \u0645\u0646\u0641\u0630\u0629 \u0641\u064a DIALux evo.",
      "tags": "DIALux evo, Lux, Sports lighting",
      "engagement": "Lighting design commission",
      "office": "Design study",
      "period": "2026",
      "disciplines": "Photometric simulation, Luminaire layout, Presentation package",
      "standards": "IEC",
      "scope_en": "Built the hall model and ran photometric simulations in DIALux evo.\nCompared luminaire layouts against the lux and uniformity targets over the court.\nDelivered the simulation report and presentation package for client approval.",
      "scope_ar": "\u0628\u0646\u0627\u0621 \u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0635\u0627\u0644\u0629 \u0648\u062a\u0646\u0641\u064a\u0630 \u0627\u0644\u0645\u062d\u0627\u0643\u0627\u0629 \u0627\u0644\u0641\u0648\u062a\u0648\u0645\u062a\u0631\u064a\u0629 \u0641\u064a DIALux evo.\n\u0645\u0642\u0627\u0631\u0646\u0629 \u062a\u0648\u0632\u064a\u0639\u0627\u062a \u0627\u0644\u0648\u062d\u062f\u0627\u062a \u0645\u0642\u0627\u0628\u0644 \u0623\u0647\u062f\u0627\u0641 \u0627\u0644\u0644\u0648\u0643\u0633 \u0648\u0627\u0644\u0627\u0646\u062a\u0638\u0627\u0645 \u0639\u0644\u0649 \u0627\u0644\u0645\u0644\u0639\u0628.\n\u062a\u0633\u0644\u064a\u0645 \u062a\u0642\u0631\u064a\u0631 \u0627\u0644\u0645\u062d\u0627\u0643\u0627\u0629 \u0648\u062d\u0632\u0645\u0629 \u0627\u0644\u0639\u0631\u0636 \u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0627\u0644\u0639\u0645\u064a\u0644.",
      "id": "reference-padel-hall-lighting",
