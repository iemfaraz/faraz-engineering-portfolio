    {
      "entity": "Project",
      "slug": "south-dhahran",
      "order": 7,
      "cat": "elv",
      "title_en": "South Dhahran Home Ownership Project",
      "title_ar": "\u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u0625\u0633\u0643\u0627\u0646 \u0627\u0644\u062a\u0645\u0644\u0651\u0643\u064a \u062c\u0646\u0648\u0628 \u0627\u0644\u0638\u0647\u0631\u0627\u0646",
      "summary_en": "Supervised installation of LV power mains, branch circuits, architectural lighting and life-safety fire alarm systems with Fawzi Saleh Al-Najrani Co., Khobar.",
      "summary_ar": "\u0627\u0644\u0625\u0634\u0631\u0627\u0641 \u0639\u0644\u0649 \u062a\u0631\u0643\u064a\u0628 \u0645\u063a\u0630\u064a\u0627\u062a \u0627\u0644\u0642\u0648\u0649 \u0648\u0627\u0644\u062f\u0648\u0627\u0626\u0631 \u0627\u0644\u0641\u0631\u0639\u064a\u0629 \u0648\u0627\u0644\u0625\u0646\u0627\u0631\u0629 \u0627\u0644\u0645\u0639\u0645\u0627\u0631\u064a\u0629 \u0648\u0623\u0646\u0638\u0645\u0629 \u0625\u0646\u0630\u0627\u0631 \u0627\u0644\u062d\u0631\u064a\u0642 \u0645\u0639 \u0634\u0631\u0643\u0629 \u0641\u0648\u0632\u064a \u0635\u0627\u0644\u062d \u0627\u0644\u0646\u062c\u0631\u0627\u0646\u064a\u060c \u0627\u0644\u062e\u0628\u0631.",
      "tags": "LV power, Fire alarm, WIR",
      "engagement": "Fawzi Saleh Al-Najrani Co., Khobar",
      "office": "Site execution",
      "period": "Aug 2024 \u2014 Jul 2025",
      "disciplines": "LV power mains, Branch circuits, Architectural lighting, Fire alarm",
      "standards": "SBC, IEC",
      "scope_en": "Supervised installation of LV power mains, branch circuits and architectural lighting.\nInspected life-safety fire alarm installation against approved drawings.\nRaised WIRs, RFIs and inspections and followed them through to consultant approval.\nEnforced QA/QC and HSE requirements on site.",
      "scope_ar": "\u0627\u0644\u0625\u0634\u0631\u0627\u0641 \u0639\u0644\u0649 \u062a\u0631\u0643\u064a\u0628 \u0645\u063a\u0630\u064a\u0627\u062a \u0627\u0644\u0642\u0648\u0649 \u0648\u0627\u0644\u062f\u0648\u0627\u0626\u0631 \u0627\u0644\u0641\u0631\u0639\u064a\u0629 \u0648\u0627\u0644\u0625\u0646\u0627\u0631\u0629 \u0627\u0644\u0645\u0639\u0645\u0627\u0631\u064a\u0629.\n\u062a\u0641\u062a\u064a\u0634 \u062a\u0631\u0643\u064a\u0628 \u0625\u0646\u0630\u0627\u0631 \u0627\u0644\u062d\u0631\u064a\u0642 \u0644\u0633\u0644\u0627\u0645\u0629 \u0627\u0644\u0623\u0631\u0648\u0627\u062d \u0645\u0642\u0627\u0628\u0644 \u0627\u0644\u0645\u062e\u0637\u0637\u0627\u062a \u0627\u0644\u0645\u0639\u062a\u0645\u062f\u0629.\n\u0631\u0641\u0639 \u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0641\u062d\u0635 \u0648\u0637\u0644\u0628\u0627\u062a \u0641\u062d\u0635 \u0627\u0644\u0623\u0639\u0645\u0627\u0644 \u0648\u0637\u0644\u0628\u0627\u062a \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0648\u0645\u062a\u0627\u0628\u0639\u062a\u0647\u0627 \u062d\u062a\u0649 \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f.\n\u062a\u0637\u0628\u064a\u0642 \u0645\u062a\u0637\u0644\u0628\u0627\u062a \u0636\u0628\u0637 \u0627\u0644\u062c\u0648\u062f\u0629 \u0648\u0627\u0644\u0633\u0644\u0627\u0645\u0629 \u0641\u064a \u0627\u0644\u0645\u0648\u0642\u0639.",
      "id": "reference-south-dhahran",
      "created_date": "2026-10-31T17:54:47.212Z"
